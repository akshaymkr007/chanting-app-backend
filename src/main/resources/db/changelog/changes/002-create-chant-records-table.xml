<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-chant-records-table" author="japa-platform">
        <createTable tableName="chant_records">
            <column name="id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="record_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="mantra_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="mantra_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="malas" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="duration_seconds" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="encrypted_note" type="TEXT"/>
            <column name="timestamp_ms" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint constraintName="uq_user_date_mantra"
                             tableName="chant_records"
                             columnNames="user_id, record_date, mantra_id"/>

        <createIndex indexName="idx_chant_user_date" tableName="chant_records">
            <column name="user_id"/>
            <column name="record_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
